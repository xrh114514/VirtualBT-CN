<Page x:Class="BluetoothLEExplorer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Behaviors="using:Template10.Behaviors"
      xmlns:Core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:controls="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:BluetoothLEExplorer.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="using:BluetoothLEExplorer.ViewModels" mc:Ignorable="d">

    <Page.DataContext>
        <vm:SettingsPageViewModel x:Name="ViewModel" />
    </Page.DataContext>


    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  TODO: change properties for narrow view  -->
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  TODO: change properties for normal view  -->
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  TODO: change properties for wide view  -->
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  header  -->
        <controls:PageHeader x:Uid="Str_Settings_Page" x:Name="pageHeader" 
                             Frame="{x:Bind Frame}"
                             RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True" />

        <!--  content  -->
        <Pivot x:Name="MyPivot" Grid.Row="1"
               RelativePanel.AlignBottomWithPanel="True"
               RelativePanel.AlignLeftWithPanel="True"
               RelativePanel.AlignRightWithPanel="True"
               RelativePanel.Below="pageHeader">

            <!--  settings  -->
            <PivotItem x:Uid="Str_Settings_4" DataContext="{Binding SettingsPartViewModel}" >
                <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                              VerticalScrollBarVisibility="Auto">
                    <RelativePanel HorizontalAlignment="Left">

                        <ToggleSwitch x:Uid="Str_Use_shell_drawn_back_button" x:Name="UseShellDrawnBackButtonToggleSwtich"
                                      
                                      IsOn="{Binding UseShellBackButton, Mode=TwoWay}"
                                      
                                      
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignTopWithPanel="True" />

                        <ToggleSwitch x:Uid="Str_Use_Light_Theme" x:Name="UseLightThemeToggleSwitch" 
                                      IsOn="{Binding UseLightThemeButton, Mode=TwoWay}"
                                      
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.Below="UseShellDrawnBackButtonToggleSwtich" />

                        <ToggleSwitch x:Uid="Str_Use_Caching" x:Name="UseCachingToggleSwitch" 
                                      IsOn="{Binding UseCachingButton, Mode=TwoWay}"
                                      
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.Below="UseLightThemeToggleSwitch" />

                        <ToggleSwitch x:Uid="Str_Close_Connections" x:Name="CloseConnectionsToggleSwitch" 
                                      IsOn="{Binding CloseConnectionsButton, Mode=TwoWay}"
                                      
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.Below="UseCachingToggleSwitch" />

                        <!--  Language switcher  -->
                        <StackPanel x:Name="LanguageRow" Orientation="Horizontal" Margin="0,16,0,0"
                                    RelativePanel.AlignLeftWithPanel="True"
                                    RelativePanel.Below="CloseConnectionsToggleSwitch">
                            <TextBlock x:Uid="Str_LangLabel" Text="语言" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="LanguageCombo" MinWidth="180" SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English" Tag="en-US" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="LangRestartText" x:Uid="Str_LangRestart" Text="切换语言后应用会自动重启。"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.Below="LanguageRow" />

                        <!--  Exit hotkey for the mouse-capture page  -->
                        <StackPanel x:Name="HotkeyRow" Orientation="Horizontal" Margin="0,16,0,0"
                                    RelativePanel.AlignLeftWithPanel="True"
                                    RelativePanel.Below="LangRestartText">
                            <TextBlock x:Uid="Str_ExitHotkeyLabel"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="ExitHotkeyButton" MinWidth="150"
                                    Click="ExitHotkeyButton_Click" />
                            <Button x:Uid="Str_ExitHotkeyReset"
                                    Margin="10,0,0,0"
                                    Click="ExitHotkeyReset_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ExitHotkeyHintText" x:Uid="Str_ExitHotkeyHint"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.Below="HotkeyRow" />

                        <!--  Fullscreen presentation of the mouse-capture page  -->
                        <StackPanel x:Name="FullscreenRow" Orientation="Horizontal" Margin="0,16,0,0"
                                    RelativePanel.AlignLeftWithPanel="True"
                                    RelativePanel.Below="ExitHotkeyHintText">
                            <TextBlock x:Uid="Str_FullscreenModeLabel"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="FullscreenModeCombo" MinWidth="220"
                                      SelectionChanged="FullscreenModeCombo_SelectionChanged">
                                <ComboBoxItem x:Uid="Str_FullscreenExclusive" Tag="Exclusive" />
                                <ComboBoxItem x:Uid="Str_FullscreenBorderless" Tag="Borderless" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Uid="Str_FullscreenModeHint"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.Below="FullscreenRow" />
                    </RelativePanel>

                </ScrollViewer>
            </PivotItem>

            <!--  privacy  -->
            <PivotItem x:Uid="Str_Privacy_statement" DataContext="{Binding SettingsPartViewModel}"
                       Padding="0" VerticalAlignment="Top">
                <HyperlinkButton NavigateUri="http://go.microsoft.com/fwlink/?LinkID=519393">Privacy Statement</HyperlinkButton>
            </PivotItem>

            <!--  about  -->
            <PivotItem x:Uid="Str_About_4" >
                <RelativePanel DataContext="{Binding AboutPartViewModel}">

                    <Border x:Name="LogoImage" HorizontalAlignment="Right"
                            VerticalAlignment="Top" BorderBrush="DimGray"
                            BorderThickness="1" IsHitTestVisible="False"
                            RelativePanel.AlignRightWithPanel="True"
                            RelativePanel.AlignTopWithPanel="True">
                        <Border.Background>
                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                        </Border.Background>
                        <Image Margin="12" Source="{Binding Logo}"
                               Stretch="None" />
                    </Border>

                    <TextBlock x:Name="DisplayNameTextBlock" Margin="0,0,0,12"
                               FontSize="24" RelativePanel.AlignLeftWithPanel="True"
                               RelativePanel.AlignRightWith="LogoImage"
                               RelativePanel.AlignTopWithPanel="True"
                               Text="VirtualBT" />

                    <TextBlock x:Name="PublisherTextBlock"
                               RelativePanel.AlignLeftWithPanel="True"
                               RelativePanel.Below="DisplayNameTextBlock"
                               Text="MikeTheTech / Microsoft" />

                    <TextBlock x:Name="VersionTextBlock"
                               RelativePanel.AlignLeftWithPanel="True"
                               RelativePanel.Below="PublisherTextBlock">
                        <Run>Version</Run>
                        <Run Text="{Binding Version}" />
                    </TextBlock>

                </RelativePanel>
            </PivotItem>
        </Pivot>

    </RelativePanel>

</Page>

