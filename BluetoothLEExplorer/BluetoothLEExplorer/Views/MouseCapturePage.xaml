<Page x:Class="BluetoothLEExplorer.Views.MouseCapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Black">

    <!-- Root grid fills the whole (fullscreen) window. Hit testing stays on so
         CoreWindow pointer events keep flowing to the page. -->
    <Grid x:Name="CaptureRoot" Background="Black">

        <!-- Status / help overlay. IsHitTestVisible=False so it never swallows
             the mouse events we are trying to capture. -->
        <StackPanel x:Name="Overlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    IsHitTestVisible="False"
                    Opacity="0.85">
            <TextBlock x:Uid="Str_Mouse_Capture_Mode" x:Name="TitleText"
                       
                       FontSize="28"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Uid="Str_Mouse_keyboard_are_captured_and_forw" x:Name="HintText"
                       
                       FontSize="16"
                       Foreground="#FFCCCCCC"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       FontSize="15"
                       Foreground="#FF7FDBFF"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock x:Name="WarnText"
                       FontSize="14"
                       Foreground="#FFFFB347"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="720"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Page>
